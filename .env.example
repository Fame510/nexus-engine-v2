NODE_ENV=production
PORT=3000
REDIS_URL=redis://redis:6379
API_KEYS=dev-key-change-me
ARTIFACT_DIR=/data/artifacts
MAX_CONCURRENCY=5
MAX_NAVIGATION_MS=45000
MAX_JOB_MS=90000
MAX_HTML_BYTES=5000000
MAX_SCREENSHOT_BYTES=12000000
DEFAULT_BROWSER=playwright
DEFAULT_MODE=headless
ALLOW_PRIVATE_TARGETS=false
LOG_LEVEL=info
